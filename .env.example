# Copy to `.env` and adjust. Never commit real secrets.
NODE_ENV=development
PORT=3000
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=15m
HASH_ROUNDS=10

# Swagger UI (set to false in production)
SWAGGER_ENABLED=false
SWAGGER_PATH=docs

# Logging (Winston) — disable request-data logging in production
LOG_DIR=logs
LOG_LEVEL=info
LOG_REQUESTS=false

# Database (PostgreSQL) — docker-compose.yml reads these same variables.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change-me
DB_NAME=messaging
DB_POOL_MIN=0
DB_POOL_MAX=10
